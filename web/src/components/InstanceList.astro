---
import { actions } from 'astro:actions';
import type { Evidence } from '../db/schema';
import { PROMINENCES } from '../db/schema';
import { db } from '../db';
import { visibleEvidence } from '../lib/caps';
import { evidenceSearchFor } from '../lib/jobs/pending';
import { parseJson } from '../lib/jobs/queue';
import { PROMINENCE_LABEL, groupByProminence, type InstanceView } from '../lib/queries';
import { formatLocator, renderInline, type RenderOptions } from '../lib/text';
import NotableMark from './NotableMark.astro';
import VerifyMark from './VerifyMark.astro';

interface Props {
  items: InstanceView[];
  /** On a trope page the row title is the work; on a media or series page it is the trope. */
  mode: 'trope' | 'subject';
  owner: boolean;
  render: RenderOptions;
  /** The current page path with its query string, for post-action redirects. */
  returnTo: string;
  /** The instance being edited (?edit=<id>): one panel with everything routine editing needs. */
  editing?: number | null;
}

const { items, mode, owner, render, returnTo, editing = null } = Astro.props;
const groups = groupByProminence(items);
const base = returnTo.split('?')[0];
// Every action lands back at the instance it touched, not at the top of the page.
const at = (id: number) => `#i-${id}`;
const plain = (id: number) => `${base}${at(id)}`;
const withEdit = (id: number) => `${base}?edit=${id}${at(id)}`;
const frames = (ev: Evidence[]) => visibleEvidence(ev, owner).filter((e) => e.kind !== 'quote');
const quotes = (ev: Evidence[]) => visibleEvidence(ev, owner).filter((e) => e.kind === 'quote');
// Over a fair-use cap (plan Phase 6): kept, shown to the owner with a tag, hidden from visitors.
const ownerOnly = (e: Evidence) => owner && !e.public;
const search = owner && editing ? evidenceSearchFor(db, editing) : undefined;
const searchLine = (() => {
  if (!search) return null;
  const r = parseJson<any>(search.result, {});
  if (search.status === 'queued' || search.status === 'running') return { live: true, text: `Looking for “${parseJson<any>(search.payload, {}).prompt}”…` };
  if (search.status === 'failed') return { live: false, text: 'The search failed.' };
  if (search.status === 'done') {
    const n = r.summary?.found ?? 0;
    const w: string[] = r.warnings ?? [];
    return { live: false, text: n > 0 ? `Found ${n} quote${n === 1 ? '' : 's'} for “${parseJson<any>(search.payload, {}).prompt}”.` : (w[0] ?? 'Nothing matched in the text.') };
  }
  return null;
})();
---

{groups.map((g) => g.items.map((v, i) => (
  <article class="row" id={`i-${v.inst.id}`} style={`padding-top: ${i === 0 ? 48 : 20}px`}>
    <div class="lab" style="padding-top: 3px">
      {i === 0 && <div class="sc group">{g.label}<span class="quiet" style="font-weight: 400">{g.items.length}</span></div>}
    </div>
    <div class="body">
      <div class="head">
        {owner && <VerifyMark instanceId={v.inst.id} verified={v.inst.verified} returnTo={`${returnTo}${at(v.inst.id)}`} />}
        <NotableMark instanceId={v.inst.id} notable={v.notable} owner={owner} returnTo={`${returnTo}${at(v.inst.id)}`} />
        {mode === 'trope'
          ? <a href={v.subject.href} class="name">{v.subject.title}</a>
          : <a href={`/tropes/${v.trope.slug}`} class="name">{v.trope.name}</a>}
        {mode === 'trope' && <span class="quiet" style="font-size: 15px">{v.subject.label}</span>}
        {mode !== 'trope' && v.viaSeries && <span class="quiet" style="font-size: 15px">as part of <a href={`/series/${v.viaSeries.slug}`} style="color: inherit">{v.viaSeries.name}</a></span>}
        {owner && editing !== v.inst.id && <a href={withEdit(v.inst.id)} class="edit">Edit</a>}
      </div>

      {owner && editing === v.inst.id ? (
        <div class="panel">
          <form method="POST" action={actions.updateInstanceText} class="textedit" id={`f-${v.inst.id}`}>
            <input type="hidden" name="instanceId" value={v.inst.id} />
            <input type="hidden" name="returnTo" value={plain(v.inst.id)} />
            <label for={`who-${v.inst.id}`} class="quiet">Who</label>
            <input id={`who-${v.inst.id}`} name="who" class="fld" value={v.inst.who} placeholder="The character, pair or element" />
            <label for={`text-${v.inst.id}`} class="quiet">Text</label>
            <textarea id={`text-${v.inst.id}`} name="text" class="fld" rows="4">{v.inst.text}</textarea>
            <p class="quiet" style="margin: 0; font-size: 14px">||double bars|| hide a spoiler. Either field may be left empty.</p>
          </form>

          <div class="rowline">
            <form method="POST" action={actions.setProminence} class="line-form">
              <input type="hidden" name="instanceId" value={v.inst.id} />
              <input type="hidden" name="returnTo" value={withEdit(v.inst.id)} />
              <span class="quiet">Prominence</span>
              {PROMINENCES.map((p) => p === v.inst.prominence
                ? <span class="on">{PROMINENCE_LABEL[p]}</span>
                : <button type="submit" name="prominence" value={p} class="t">{PROMINENCE_LABEL[p]}</button>)}
            </form>
          </div>

          <div class="evblock">
            <span class="quiet">Evidence</span>
            {v.evidence.length === 0 && <span class="quiet" style="font-size: 15px">none yet</span>}
            {v.evidence.map((e) => (
              <form method="POST" action={actions.removeEvidence} class="evrow">
                <input type="hidden" name="evidenceId" value={e.id} />
                <input type="hidden" name="returnTo" value={withEdit(v.inst.id)} />
                <span class="evtext">{e.kind === 'quote' ? <Fragment set:html={renderInline(e.content ?? '', render)} /> : e.kind}{e.locator && <span class="loc">{formatLocator(e.locator)}</span>}</span>
                <button type="submit" class="t danger">Remove</button>
                {e.kind === 'quote' && /\d+:\d{2}$/.test(e.locator) && <button type="submit" class="t" formaction={actions.makeClip} name="quoteId" value={e.id}>Clip</button>}
              </form>
            ))}
            <form method="POST" action={actions.findEvidence} class="find">
              <input type="hidden" name="instanceId" value={v.inst.id} />
              <input type="hidden" name="returnTo" value={withEdit(v.inst.id)} />
              <label for={`fe-${v.inst.id}`} class="quiet">Find</label>
              <input id={`fe-${v.inst.id}`} name="prompt" class="line" placeholder="the moment you want quoted" style="flex: 1 1 260px" />
              <button type="submit" class="t">Search the text</button>
            </form>
            {searchLine && (
              <p class:list={['quiet', 'status', { live: searchLine.live }]} style="margin: 2px 0 0; font-size: 14px" data-job={searchLine.live ? search!.id : undefined}>{searchLine.text}</p>
            )}
          </div>

          <div class="actions">
            <button type="submit" form={`f-${v.inst.id}`} class="go">Save</button>
            <a href={plain(v.inst.id)} class="quiet">Cancel</a>
            <form method="POST" action={actions.removeInstance} class="remove" onsubmit="return confirm('Remove this association? There is no undo.')">
              <input type="hidden" name="instanceId" value={v.inst.id} />
              <input type="hidden" name="returnTo" value={base} />
              <button type="submit" class="t danger">Remove association</button>
            </form>
          </div>
        </div>
      ) : (
        <p style="margin: 2px 0 0">
          {v.inst.who && <span style="font-style: italic">{v.inst.who}.</span>}
          {v.inst.who && ' '}
          <Fragment set:html={renderInline(v.inst.text, render)} />
        </p>
      )}
    </div>
    <aside class="mar">
      {quotes(v.evidence).map((q) => (
        <p class="quote"><Fragment set:html={renderInline(q.content ?? '', render)} />{q.locator && <span class="loc">{formatLocator(q.locator)}</span>}{ownerOnly(q) && <span class="loc" title="Over the fair-use cap; visitors do not see it">owner only</span>}</p>
      ))}
      {frames(v.evidence).length > 0 && (
        <div class="gal">
          {frames(v.evidence).map((f) => (
            <figure style="margin: 0">
              {f.filePath && f.kind === 'clip'
                ? <video controls preload="none" src={`/evidence/${f.filePath}`} style="display: block; width: 100%; aspect-ratio: 16 / 9; background: #000"></video>
                : f.filePath
                  ? <img src={`/evidence/${f.filePath}`} alt={f.locator} style="display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover" loading="lazy" />
                  : <div class="fr">{f.kind === 'clip' && <svg width="22" height="22" viewBox="0 0 22 22" aria-label="Clip on its way" role="img"><path d="M7 4l11 7-11 7z" fill="currentColor"></path></svg>}</div>}
              <figcaption class="quiet" style="font-size: 14px; margin-top: 2px">{f.locator}{ownerOnly(f) && <span class="loc" title="Over the fair-use cap; visitors do not see it">owner only</span>}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </aside>
  </article>
)))}

<script>
  // While an evidence search runs, poll it and reload once it lands so the quotes appear.
  const el = document.querySelector<HTMLElement>('.status.live[data-job]');
  if (el) {
    const id = el.dataset.job;
    const tick = async () => {
      try {
        const r = await fetch(`/api/jobs/${id}`, { headers: { accept: 'application/json' } });
        if (r.ok) {
          const j = await r.json();
          if (j.status !== 'running' && j.status !== 'queued') { location.reload(); return; }
        }
      } finally {
        setTimeout(tick, 2000);
      }
    };
    setTimeout(tick, 2000);
  }
</script>

<style>
  .group { font-weight: 700; font-size: 19px; border-top: 2px solid #1B1B1B; padding-top: 6px; display: flex; justify-content: space-between; gap: 8px; }
  .body { border-top: 1px solid #E4E3DF; padding-top: 10px; min-width: 0; }
  .head { display: flex; flex-wrap: wrap; gap: 0 10px; align-items: baseline; }
  .name { font-weight: 700; color: #1B1B1B; }
  .edit { margin-left: auto; font-size: 15px; padding: 8px 0; }
  .mar { border-top: 1px solid #E4E3DF; padding-top: 12px; font-size: 15px; line-height: 1.5; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .quote { margin: 0; font-style: italic; color: #3A3A36; max-width: 640px; }
  /* The edit panel: one bordered block, everything routine in it. */
  .panel { margin: 10px 0 8px; padding: 12px 0 12px 16px; border-left: 2px solid #1B1B1B; font-size: 16px; display: flex; flex-direction: column; gap: 14px; }
  .panel .quiet { font-size: 15px; }
  .textedit { display: flex; flex-direction: column; gap: 6px; }
  .rowline { display: flex; flex-wrap: wrap; gap: 4px 28px; align-items: baseline; }
  .line-form { display: flex; flex-wrap: wrap; gap: 0 14px; align-items: baseline; }
  .line-form .t, .line-form .on { padding: 6px 0; }
  .on { font-weight: 700; }
  .evblock { display: flex; flex-direction: column; gap: 4px; }
  .evrow { display: flex; gap: 12px; align-items: baseline; font-size: 15px; }
  .evrow .t { padding: 4px 0; flex: none; }
  .evtext { font-style: italic; color: #3A3A36; }
  .find { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; margin-top: 4px; }
  .find .t { padding: 6px 0; }
  .status.live::after { content: ' ·'; animation: blink 1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }
  .actions { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; padding-top: 4px; border-top: 1px solid #ECEBE7; }
  .actions .remove { margin-left: auto; }
  .actions a { padding: 10px 0; }
</style>
