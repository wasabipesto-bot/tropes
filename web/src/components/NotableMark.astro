---
import { actions } from 'astro:actions';

/** The star: a pinned (notable) example. The owner clicks it anywhere, in or out of edit mode; everyone else sees it when set. */
interface Props { instanceId: number; notable: boolean; owner: boolean; returnTo: string }
const { instanceId, notable, owner, returnTo } = Astro.props;
const path = 'M8 1.8l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.6l-3.8 2 .7-4.3-3.1-3 4.3-.6z';
---

{owner ? (
  <form method="POST" action={actions.toggleNotable} style="display: inline-flex">
    <input type="hidden" name="instanceId" value={instanceId} />
    <input type="hidden" name="returnTo" value={returnTo} />
    <button type="submit" class="ico" aria-label={notable ? 'Notable example. Click to unpin.' : 'Click to pin as a notable example.'} title={notable ? 'Notable. Click to unpin.' : 'Pin as notable'}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill={notable ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d={path}></path></svg>
    </button>
  </form>
) : notable && (
  <span class="ico" title="A notable example" style="display: inline-flex">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d={path}></path></svg>
  </span>
)}
