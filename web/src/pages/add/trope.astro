---
import { actions } from 'astro:actions';
import Base from '../../layouts/Base.astro';
import JobStatus from '../../components/JobStatus.astro';
import ProposalList from '../../components/ProposalList.astro';
import { db } from '../../db';
import { afterAction } from '../../lib/after-action';
import { reviewState } from '../../lib/jobs/page';
import { framesJobFor } from '../../lib/jobs/pending';
import { UNCHECKED_BELOW, calibrationLine, proposalsFor } from '../../lib/jobs/view';
import { count } from 'drizzle-orm';
import { media } from '../../db/schema';
import { tropeHrefResolver } from '../../lib/queries';
import { parseJson } from '../../lib/jobs/queue';

if (!Astro.locals.owner) return Astro.redirect('/login');
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;
const { job, editing, summary, warnings, returnTo } = reviewState(Astro, db);
const [{ n: total }] = db.select({ n: count() }).from(media).all();
const draft = job ? parseJson<any>(job.payload, {}).draft : null;
const items = job?.status === 'done' ? proposalsFor(db, job, summary.uncheckedBelow ?? UNCHECKED_BELOW) : [];
const render = { tropeHref: tropeHrefResolver(db) };
const step = !job ? 'Step 1 of 2: describe it' : job.status === 'done' ? 'Step 2 of 2: check the scan. Nothing is saved until you commit.' : 'Scanning';
const describeHref = draft ? `/add/trope?name=${encodeURIComponent(draft.name)}&description=${encodeURIComponent(draft.description)}&examples=${encodeURIComponent((draft.seeds ?? []).join('\n'))}` : '/add/trope';
const q = Astro.url.searchParams;
---

<Base title="Add a trope" current="add-trope">
  <h1>Add a trope</h1>
  <p class="quiet" style="margin: 4px 0 0; font-size: 15px">{step}</p>

  {!job && (
    <form method="POST" action={actions.startTropeScan} style="max-width: 680px; margin-top: 32px; display: flex; flex-direction: column; gap: 22px">
      <div>
        <label for="n" style="display: block; font-weight: 600; margin-bottom: 4px">Name</label>
        <input id="n" name="name" class="fld" type="text" required value={q.get('name') ?? ''} />
      </div>
      <div>
        <label for="d" style="display: block; font-weight: 600">Description</label>
        <p class="quiet" style="margin: 0 0 6px; font-size: 15px">A sentence or two. Write [[Trope name]] to link another trope.</p>
        <textarea id="d" name="description" class="fld" rows="3">{q.get('description') ?? ''}</textarea>
      </div>
      <div>
        <label for="e" style="display: block; font-weight: 600">Examples</label>
        <p class="quiet" style="margin: 0 0 6px; font-size: 15px">One per line. Used to check the scan, so pick clear ones.</p>
        <textarea id="e" name="examples" class="fld" rows="3">{q.get('examples') ?? ''}</textarea>
      </div>
      <label style="display: flex; gap: 10px; align-items: baseline; font-size: 16px"><input type="checkbox" name="visual" /> Visual trope, use screenshots <span class="quiet" style="font-size: 15px">(the model checks the frame at each quoted moment before proposing)</span></label>
      {error && <p class="quiet" style="margin: 0; font-size: 15px">{error}</p>}
      <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap">
        <button type="submit" class="go">Scan {total} entries</button>
        <a href="/tropes" style="font-size: 16px">Cancel</a>
      </div>
    </form>
  )}

  {job && job.status !== 'done' && <JobStatus job={job} total={total} returnTo="/add/trope" what={`Scanning ${total} entries for ${draft?.name ?? 'the trope'}.`} />}

  {job && job.status === 'done' && (
    <>
      <div style="max-width: 760px; margin-top: 28px">
        <p style="margin: 0"><span style="font-weight: 700">{draft.name}.</span> {draft.description} <a href={describeHref}>Edit</a></p>
        <p style="margin: 16px 0 0">{calibrationLine(summary, summary.uncheckedBelow ?? UNCHECKED_BELOW)}</p>
        {warnings.map((w) => <p class="quiet" style="margin: 6px 0 0; font-size: 15px">{w}</p>)}
        {error && <p class="quiet" style="margin: 6px 0 0; font-size: 15px">{error}</p>}
      </div>
      <div style="margin-top: 32px; max-width: 820px">
        <ProposalList jobId={job.id} items={items} framesJob={framesJobFor(db, job)} mode="trope" render={render} returnTo={returnTo} verb="Commit" cancelHref={`/add/trope?discard=${job.id}`} cancelLabel="Discard" rescan={{ href: describeHref, label: 'Change description and rescan' }} />
      </div>
      {q.get('discard') === String(job.id) && (
        <form method="POST" action={actions.discardJob} style="margin-top: 20px">
          <input type="hidden" name="jobId" value={job.id} />
          <input type="hidden" name="returnTo" value="/tropes" />
          <p style="margin: 0 0 8px">Discard this scan and its proposals?</p>
          <button type="submit" class="t danger">Discard</button>
        </form>
      )}
    </>
  )}
</Base>
