---
import { actions } from 'astro:actions';
import Base from '../../layouts/Base.astro';
import JobStatus from '../../components/JobStatus.astro';
import ProposalList from '../../components/ProposalList.astro';
import { db } from '../../db';
import { MEDIA_TYPES } from '../../db/schema';
import { afterAction } from '../../lib/after-action';
import { reviewState } from '../../lib/jobs/page';
import { parseJson } from '../../lib/jobs/queue';
import { UNCHECKED_BELOW, proposalsFor } from '../../lib/jobs/view';
import { allTropes, subjectRef, tropeHrefResolver } from '../../lib/queries';

if (!Astro.locals.owner) return Astro.redirect('/login');
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;
const { job, editing, summary, warnings, returnTo } = reviewState(Astro, db);
const subject = job ? subjectRef(db, parseJson<any>(job.payload, {}).subject.kind, parseJson<any>(job.payload, {}).subject.id) : undefined;
const items = job?.status === 'done' ? proposalsFor(db, job, summary.uncheckedBelow ?? UNCHECKED_BELOW) : [];
const render = { tropeHref: tropeHrefResolver(db) };
const tropeCount = allTropes(db).length;
---

<Base title="Add a media item" current="add-media">
  <h1>Add a media item</h1>

  {!job && (
    <>
      <form method="POST" action={actions.startSubjectCheck} style="margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; max-width: 680px">
        <input type="hidden" name="mode" value="add" />
        <label for="m" class="visually-hidden">Title</label>
        <input id="m" name="title" class="fld" type="text" style="flex: 1 1 320px" required />
        <button type="submit" class="go">Check against {tropeCount} tropes</button>
      </form>
      <p class="quiet" style="margin: 10px 0 0; font-size: 15px">The title must already be in the library; the lookup against external sources arrives in Phase 4.</p>
      {error && <p class="quiet" style="margin: 10px 0 0; font-size: 15px">{error}</p>}
      <details style="margin-top: 36px; max-width: 680px">
        <summary style="cursor: pointer">Create an entry by hand</summary>
        <form method="POST" action={actions.createMedia} style="margin-top: 16px; display: flex; flex-direction: column; gap: 18px">
          <div><label for="t" style="display: block; font-weight: 600; margin-bottom: 4px">Title</label><input id="t" name="title" class="fld" type="text" required /></div>
          <div><label for="ty" style="display: block; font-weight: 600; margin-bottom: 4px">Type</label><select id="ty" name="type" class="fld" style="width: auto">{MEDIA_TYPES.map((t) => <option value={t}>{t}</option>)}</select></div>
          <div><label for="c" style="display: block; font-weight: 600; margin-bottom: 4px">Creator</label><input id="c" name="creator" class="fld" type="text" /></div>
          <div><button type="submit" class="go">Add to library</button></div>
        </form>
      </details>
    </>
  )}

  {job && job.status !== 'done' && <JobStatus job={job} total={tropeCount} returnTo="/add/media" what={`Checking ${subject?.title ?? 'the work'} against ${tropeCount} tropes.`} />}

  {job && job.status === 'done' && subject && (
    <>
      <p class="quiet" style="margin: 4px 0 0; font-size: 15px">Here is what turned up for “{subject.title}.” Nothing is saved until you add it. <a href="/add/media">Start over</a></p>
      <div style="max-width: 720px">
        <h2 style="margin: 36px 0 0; font-size: 28px; font-weight: 700"><a href={subject.href} style="color: inherit">{subject.title}</a></h2>
        <h3 style="margin: 36px 0 2px; font-size: 20px; font-weight: 700">Tropes</h3>
        <p class="quiet" style="margin: 0 0 8px; font-size: 15px">Checked against {summary.checked ?? tropeCount}. {summary.matched === 0 ? 'Nothing matched.' : `${summary.matched} matched.`}{summary.hasText === false ? ' No text of the work was available.' : ''}</p>
        {warnings.map((w) => <p class="quiet" style="margin: 0 0 8px; font-size: 15px">{w}</p>)}
        {error && <p class="quiet" style="margin: 0 0 8px; font-size: 15px">{error}</p>}
        <ProposalList jobId={job.id} items={items} mode="subject" render={render} returnTo={returnTo} editing={editing} verb="Add" cancelHref="/add/media" cancelLabel="Start over" />
      </div>
    </>
  )}
</Base>
