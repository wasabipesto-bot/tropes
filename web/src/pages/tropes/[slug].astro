---
import { tropeSeed } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { plainText } from '../../lib/text';
import { actions } from 'astro:actions';
import Base from '../../layouts/Base.astro';
import InstanceList from '../../components/InstanceList.astro';
import { db } from '../../db';
import { afterAction } from '../../lib/after-action';
import { pendingReviewFor } from '../../lib/jobs/pending';
import { instancesForTrope, notableFor, subjectTitles, tropeByAliasSlug, tropeBySlug, tropeHrefResolver } from '../../lib/queries';
import { renderText } from '../../lib/text';

const t = tropeBySlug(db, Astro.params.slug ?? '');
if (!t) {
  // A renamed trope keeps answering at its old address.
  const moved = tropeByAliasSlug(db, Astro.params.slug ?? '');
  if (moved) return Astro.redirect(`/tropes/${moved.slug}`, 301);
  return new Response(null, { status: 404 });
}
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;

const owner = Astro.locals.owner;
const p = Astro.url.searchParams;
const editDesc = owner && p.get('edit') === 'desc';
const editName = owner && p.get('edit') === 'name';
const pending = owner ? pendingReviewFor(db, 'trope', t.id) : null;
const fmt = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const editing = owner && /^\d+$/.test(p.get('edit') ?? '') ? Number(p.get('edit')) : null;

const render = { tropeHref: tropeHrefResolver(db) };
const items = instancesForTrope(db, t.id);
const seeds = db.select().from(tropeSeed).where(eq(tropeSeed.tropeId, t.id)).all();
const notable = notableFor(db, t.id, items);
const here = `/tropes/${t.slug}`;
const returnTo = Astro.url.pathname + Astro.url.search;
---

<Base title={t.name} wide description={plainText(t.description) || `Works in the log that use ${t.name}.`}>
  <div class="row">
    <div class="lab"></div>
    <div>
      {editName ? (
        <form method="POST" action={actions.renameTrope} style="display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap">
          <input type="hidden" name="tropeId" value={t.id} />
          <label for="nm" class="visually-hidden">Name</label>
          <input id="nm" name="name" class="fld" value={t.name} style="font-size: 28px; font-weight: 700; max-width: 520px" autofocus />
          <button type="submit" class="t">Save</button><a href={here} class="quiet">Cancel</a>
          <span class="quiet" style="font-size: 15px; flex-basis: 100%">[[{t.name}]] links everywhere become the new name; the old address keeps working.</span>
        </form>
      ) : (
        <h1>{t.name}</h1>
      )}
      {editDesc ? (
        <form method="POST" action={actions.updateTropeDescription} style="margin-top: 20px">
          <input type="hidden" name="tropeId" value={t.id} />
          <input type="hidden" name="returnTo" value={here} />
          <label for="desc" class="visually-hidden">Description</label>
          <textarea id="desc" name="description" class="fld" rows="5">{t.description}</textarea>
          <p class="quiet" style="margin: 4px 0 0; font-size: 15px">[[Trope name]] links to another trope.</p>
          <label style="display: flex; gap: 10px; align-items: baseline; font-size: 16px; margin-top: 10px"><input type="checkbox" name="visual" checked={t.visual} /> Visual trope, use screenshots <span class="quiet" style="font-size: 15px">(the model checks the frame at each quoted moment before proposing)</span></label>
          <p class="quiet" style="margin: 14px 0 4px; font-size: 15px">Examples the scans calibrate on:</p>
          {seeds.map((sd) => (
            <p style="margin: 0; font-size: 15px; display: flex; gap: 12px; align-items: baseline">{sd.title}{sd.note && <span class="quiet">— {sd.note}</span>}{!sd.mediaId && <span class="quiet">(not matched to a work)</span>}<button type="submit" class="t danger" formaction={actions.removeSeed} name="seedId" value={sd.id} style="padding: 2px 0; font-size: 14px">Remove</button></p>
          ))}
          <p style="margin: 8px 0 0; font-size: 16px; display: flex; gap: 16px"><button type="submit" class="t" style="padding: 8px 0">Save</button><a href={here} class="quiet" style="padding: 8px 0">Cancel</a></p>
        </form>
        <form method="POST" action={actions.addSeed} style="margin-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; font-size: 15px">
          <input type="hidden" name="tropeId" value={t.id} /><input type="hidden" name="returnTo" value={`${here}?edit=desc`} />
          <input name="title" list="subjects" placeholder="Add an example" class="line" style="width: 220px" autocomplete="off" />
          <input name="note" placeholder="note (optional)" class="line" style="width: 180px" />
          <button type="submit" class="t" style="padding: 4px 0">Add example</button>
        </form>
      ) : (
        <>
          {t.description
            ? <div class="desc"><Fragment set:html={renderText(t.description, render, ' style="margin: 20px 0 0"')} /></div>
            : owner && <p class="quiet" style="margin: 20px 0 0">No description yet.</p>}
          {owner && <p style="margin: 8px 0 0; font-size: 15px; display: flex; gap: 16px; flex-wrap: wrap"><a href={`${here}?edit=desc`} style="padding: 6px 0">Edit description</a><a href={`${here}?edit=name`} style="padding: 6px 0">Edit name</a><a href={`/recheck/trope/${t.slug}`} style="padding: 6px 0">Recheck instances</a></p>}
          {owner && pending && <p class="quiet" style="margin: 6px 0 0; font-size: 15px">A recheck from {fmt(pending.createdAt)} is <a href={pending.href}>waiting for review</a>.</p>}
        </>
      )}
      {error && <p class="quiet" style="margin: 8px 0 0; font-size: 15px">{error}</p>}
      {notable.length > 0 && <p style="margin: 16px 0 0">Notable: {notable.map((v, i) => <><a href={v.subject.href}>{v.subject.title}</a>{i < notable.length - 1 ? ', ' : '.'}</>)}</p>}
    </div>
    <div></div>
  </div>

  {items.length === 0 && (
    <div class="row" style="margin-top: 48px"><div class="lab"></div><p class="quiet" style="margin: 0">No instances yet.</p><div></div></div>
  )}
  <InstanceList items={items} mode="trope" owner={owner} render={render} returnTo={returnTo} editing={editing} />

  {owner && (
    <div class="row" style="margin-top: 56px">
      <div class="lab"></div>
      <form method="POST" action={actions.addInstanceByTitle} class="add">
        <input type="hidden" name="tropeId" value={t.id} />
        <input type="hidden" name="returnTo" value={here} />
        <label for="addm" class="quiet">Add media to this trope</label>
        <input id="addm" name="title" list="subjects" placeholder="Title" class="line" style="width: 240px" autocomplete="off" />
        <datalist id="subjects">{subjectTitles(db).map((s) => <option value={s}></option>)}</datalist>
        <input name="note" placeholder="note for the model (optional)" class="line" style="width: 240px" />
        <button type="submit" class="t" name="mode" value="draft" style="padding: 8px 0">Add and write it</button>
        <button type="submit" class="t quiet" name="mode" value="manual" style="padding: 8px 0">Add, I'll write it</button>
      </form>
      <div></div>
    </div>
  )}
</Base>

<style>
  .add { border-top: 1px solid #1B1B1B; padding-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: baseline; font-size: 16px; }
</style>
