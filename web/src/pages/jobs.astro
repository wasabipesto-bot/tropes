---
import { desc } from 'drizzle-orm';
import { actions } from 'astro:actions';
import Base from '../layouts/Base.astro';
import JobStatus from '../components/JobStatus.astro';
import { db } from '../db';
import { dossier, job } from '../db/schema';
import { afterAction } from '../lib/after-action';
import { reviewState } from '../lib/jobs/page';
import { parseJson } from '../lib/jobs/queue';
import { count } from 'drizzle-orm';

if (!Astro.locals.owner) return Astro.redirect('/login');
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;
const { job: current } = reviewState(Astro, db);
const quietSync = (j: typeof job.$inferSelect) => {
  if (j.kind !== 'sync_notion' || j.status !== 'done') return false;
  const s = parseJson<any>(j.result, {})?.summary ?? {};
  return !(s.inserted || s.updated || s.missing);
};
const all = db.select().from(job).orderBy(desc(job.id)).limit(400).all();
const quiet = all.filter(quietSync).length;
const recent = all.filter((j) => !quietSync(j)).slice(0, 30);
const [{ n: dossiers }] = db.select({ n: count() }).from(dossier).all();
const cost = (j: typeof recent[number]) => { const u = parseJson<any>(j.usage, null); return u?.costUsd ? `$${u.costUsd.toFixed(3)}` : ''; };
// Spend: every job's usage, summed per day (UTC) for the last 30 days and for the calendar month.
const today = new Date();
const monthKey = today.toISOString().slice(0, 7);
const dayKeys = Array.from({ length: 30 }, (_, i) => new Date(today.getTime() - (29 - i) * 86_400_000).toISOString().slice(0, 10));
const perDay = new Map<string, number>(dayKeys.map((k) => [k, 0]));
let monthTotal = 0;
for (const j of db.select({ finishedAt: job.finishedAt, createdAt: job.createdAt, usage: job.usage }).from(job).all()) {
  const u = parseJson<any>(j.usage, null);
  if (!u?.costUsd) continue;
  const when = (j.finishedAt ?? j.createdAt).slice(0, 10);
  if (when.startsWith(monthKey)) monthTotal += u.costUsd;
  if (perDay.has(when)) perDay.set(when, perDay.get(when)! + u.costUsd);
}
const dayMax = Math.max(0.01, ...perDay.values());
const monthName = today.toLocaleDateString('en-GB', { month: 'long' });
---

<Base title="Jobs" noindex>
  <h1>Jobs</h1>
  <p class="quiet" style="margin: 4px 0 0; font-size: 15px">{dossiers} dossiers built. The worker runs on ivory with `just worker`.{quiet > 0 && ` ${quiet} Notion syncs with nothing to do are not listed.`} <a href="/metadata">Metadata lookups</a></p>
  {error && <p class="quiet" style="margin: 8px 0 0; font-size: 15px">{error}</p>}
  <section class="spend">
    <p style="margin: 0; font-size: 16px"><span style="font-weight: 700">${monthTotal.toFixed(2)}</span> <span class="quiet">spent on the model in {monthName}</span></p>
    <svg viewBox="0 0 300 48" width="300" height="48" role="img" aria-label={`Cost per day over the last 30 days, peak $${dayMax.toFixed(2)}`} style="display: block; margin-top: 6px; overflow: visible">
      {dayKeys.map((k, i) => {
        const v = perDay.get(k)!;
        const h = v > 0 ? Math.max(1, (v / dayMax) * 40) : 0;
        return <rect x={i * 10} y={40 - h} width="8" height={h} fill={i === 29 ? '#9A2B1E' : '#1B1B1B'}><title>{k}: ${v.toFixed(3)}</title></rect>;
      })}
      <line x1="0" y1="40.5" x2="300" y2="40.5" stroke="#E4E3DF" />
    </svg>
    <p class="quiet" style="margin: 2px 0 0; font-size: 13px">last 30 days, peak ${dayMax.toFixed(2)}; today in red</p>
  </section>
  <form method="POST" action={actions.startDossierBuild} style="margin-top: 24px; display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap">
    <button type="submit" class="t" name="onlyMissing" value="true">Build missing dossiers</button>
    <button type="submit" class="t" name="onlyMissing" value="false">Rebuild all dossiers</button>
  </form>
  {current && current.status !== 'done' && <JobStatus job={current} returnTo="/jobs" what={`${current.kind} ${current.id}.`} />}
  <div style="overflow-x: auto; margin-top: 32px">
    <table style="min-width: 640px">
      <thead><tr><th><span class="th">Job</span></th><th><span class="th">Kind</span></th><th><span class="th">Status</span></th><th><span class="th">Created</span></th><th><span class="th">Cost</span></th><th><span class="th">Summary</span></th></tr></thead>
      <tbody>
        {recent.map((j) => (
          <tr>
            <td class="num"><a href={`/jobs?job=${j.id}`}>{j.id}</a></td>
            <td style="font-size: 15px">{j.kind}</td>
            <td style="font-size: 15px">{j.status}</td>
            <td class="quiet num" style="font-size: 15px">{j.createdAt.slice(0, 16)}</td>
            <td class="num" style="font-size: 15px">{cost(j)}</td>
            <td class="quiet" style="font-size: 14px; max-width: 420px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">{j.error ? j.error.slice(0, 120) : JSON.stringify(parseJson<any>(j.result, {})?.summary ?? {}).slice(0, 160)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
<style>
  .spend { margin-top: 20px; }
</style>
