---
import Base from '../../layouts/Base.astro';

if (!Astro.locals.owner) return Astro.redirect('/login');
const back = Astro.request.headers.get('referer') ?? '/tropes';
---

<Base title="Recheck">
  <h1>Recheck</h1>
  <p class="quiet" style="margin: 28px 0 0">Rechecks run the matching pipeline, which arrives in Phase 3. <a href={back}>Go back</a>.</p>
</Base>
