---
import { actions } from 'astro:actions';
import Base from '../../../layouts/Base.astro';
import JobStatus from '../../../components/JobStatus.astro';
import ProposalList from '../../../components/ProposalList.astro';
import { db } from '../../../db';
import { afterAction } from '../../../lib/after-action';
import { reviewState } from '../../../lib/jobs/page';
import { UNCHECKED_BELOW, proposalsFor } from '../../../lib/jobs/view';
import { tropeBySlug, tropeHrefResolver } from '../../../lib/queries';
import { count } from 'drizzle-orm';
import { media } from '../../../db/schema';
import { pendingReviewFor } from '../../../lib/jobs/pending';

if (!Astro.locals.owner) return Astro.redirect('/login');
const t = tropeBySlug(db, Astro.params.slug ?? '');
if (!t) return new Response(null, { status: 404 });
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;
const state = reviewState(Astro, db);
const job = state.job ?? (state.jobId ? undefined : pendingReviewFor(db, 'trope', t.id)?.job);
const { editing, warnings } = state;
const summary = job ? (JSON.parse(job.result ?? '{}')?.summary ?? {}) : {};
const returnTo = job ? `${Astro.url.pathname}?job=${job.id}` : state.returnTo;
const [{ n: total }] = db.select({ n: count() }).from(media).all();
const items = job?.status === 'done' ? proposalsFor(db, job, summary.uncheckedBelow ?? UNCHECKED_BELOW) : [];
const render = { tropeHref: tropeHrefResolver(db) };
const here = `/recheck/trope/${t.slug}`;
---

<Base title={`Recheck ${t.name}`}>
  <h1>Recheck <a href={`/tropes/${t.slug}`} style="color: #1B1B1B">{t.name}</a></h1>
  {!job && (
    <form method="POST" action={actions.startTropeRecheck} style="margin-top: 28px; display: flex; gap: 20px; align-items: center; flex-wrap: wrap">
      <input type="hidden" name="tropeId" value={t.id} />
      <button type="submit" class="go">Scan {total} entries</button>
      <a href={`/tropes/${t.slug}`} style="font-size: 16px">Cancel</a>
      {error && <span class="quiet" style="font-size: 15px">{error}</span>}
    </form>
  )}
  {job && job.status !== 'done' && <JobStatus job={job} total={total} returnTo={`/tropes/${t.slug}`} what={`Scanning ${total} entries.`} />}
  {job && job.status === 'done' && (
    <>
      <p class="quiet" style="margin: 4px 0 0; font-size: 15px">{summary.scanned ?? total} entries scanned. Nothing is saved until you add it.</p>
      {warnings.map((w) => <p class="quiet" style="margin: 6px 0 0; font-size: 15px">{w}</p>)}
      {error && <p class="quiet" style="margin: 6px 0 0; font-size: 15px">{error}</p>}
      {items.length === 0 && <p style="margin: 28px 0 0">Nothing new to add.</p>}
      <div style="margin-top: 36px; max-width: 820px">
        <ProposalList jobId={job.id} items={items} mode="trope" render={render} returnTo={returnTo} verb="Add" cancelHref={`/tropes/${t.slug}`}>
          <h2 slot="instances-heading" style="margin: 0 0 4px; font-size: 22px; font-weight: 700">New instances</h2>
          <h2 slot="evidence-heading" style="margin: 0 0 4px; font-size: 22px; font-weight: 700">New evidence for existing instances</h2>
        </ProposalList>
      </div>
    </>
  )}
</Base>
