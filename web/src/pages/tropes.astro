---
import Base from '../layouts/Base.astro';
// Phase 2 adds the trope table. Until then the page carries only its frame.
const total = 0;
---

<Base title="Tropes" current="tropes">
  <div style="display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline">
    <h1>Tropes</h1>
    <span class="quiet" style="font-size: 15px">{total} of {total}</span>
  </div>
  <p class="quiet" style="margin: 28px 0 0">No tropes yet.</p>
</Base>
