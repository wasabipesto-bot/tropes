---
import { eq } from 'drizzle-orm';
import { actions } from 'astro:actions';
import Base from '../../../layouts/Base.astro';
import JobStatus from '../../../components/JobStatus.astro';
import ProposalList from '../../../components/ProposalList.astro';
import { db } from '../../../db';
import { localSource, media } from '../../../db/schema';
import { afterAction } from '../../../lib/after-action';
import { candidateLine } from '../../../lib/jobs/matches';
import { reviewState } from '../../../lib/jobs/page';
import { framesJobFor, pendingReviewFor, refreshStatusFor } from '../../../lib/jobs/pending';
import { latestJob } from '../../../lib/jobs/queue';
import { UNCHECKED_BELOW, proposalsFor } from '../../../lib/jobs/view';
import { SITE_LABELS, type Details } from '../../../lib/media';
import { parseCandidates, parseDetails, parseIds } from '../../../lib/metadata';
import { allTropes, tropeHrefResolver } from '../../../lib/queries';

if (!Astro.locals.owner) return Astro.redirect('/login');
const id = Number(Astro.params.id);
const m = Number.isInteger(id) ? db.select().from(media).where(eq(media.id, id)).get() : undefined;
if (!m) return new Response(null, { status: 404 });
const { redirect, error } = afterAction(Astro);
if (redirect) return redirect;

const state = reviewState(Astro, db);
const job = state.job ?? (state.jobId ? undefined : pendingReviewFor(db, 'media', m.id)?.job);
// With nothing waiting, the last finished check is still worth a line: "nothing new" is an answer.
const lastCheck = !job ? latestJob(db, 'check_subject', (pl) => pl.subject?.kind === 'media' && pl.subject?.id === m.id) : undefined;
const lastSummary = lastCheck?.status === 'done' ? (JSON.parse(lastCheck.result ?? '{}')?.summary ?? {}) : null;
const fmtDate = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });
const summary = job ? (JSON.parse(job.result ?? '{}')?.summary ?? {}) : {};
const warnings: string[] = job ? (JSON.parse(job.result ?? '{}')?.warnings ?? []) : [];
const returnTo = job ? `${Astro.url.pathname}?job=${job.id}` : Astro.url.pathname;
const tropeCount = allTropes(db).length;
const items = job?.status === 'done' ? proposalsFor(db, job, summary.uncheckedBelow ?? UNCHECKED_BELOW) : [];
const render = { tropeHref: tropeHrefResolver(db) };

const details = parseDetails(m) as Details;
// What the media worker found on the disk for this work, and where a refresh of it stands.
const files = db.select().from(localSource).where(eq(localSource.mediaId, m.id)).all();
const meta = (s: { meta: string }) => JSON.parse(s.meta || '{}');
const videos = files.filter((s) => s.kind === 'video');
const withText = videos.filter((s) => s.indexedAt && meta(s).textSource && meta(s).textSource !== 'none');
const withSheets = videos.filter((s) => meta(s).sheets);
const books = files.filter((s) => s.kind === 'book');
const texts = files.filter((s) => s.kind === 'text');
const fileLine = [
  videos.length > 0 && `${videos.length} ${videos.some((s) => s.label) ? 'episodes' : videos.length === 1 ? 'film file' : 'film files'} (subtitles for ${withText.length}${videos.some((s) => s.indexedAt) ? '' : ', not yet extracted'}; contact sheets for ${withSheets.length})`,
  books.length > 0 && `${books.length} ${books.length === 1 ? 'book' : 'books'}`,
  texts.length > 0 && `${texts.length} linked ${texts.length === 1 ? 'text' : 'texts'} (${texts.map((t) => t.label || t.path.split('/').pop()).join(', ')})`,
].filter(Boolean).join('; ');
const refresh = refreshStatusFor(db, m.id);
const fmtWhen = (iso: string) => new Date(iso.replace(' ', 'T') + 'Z').toLocaleString('en-GB', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });
const ids = parseIds(m);
const candidates = parseCandidates(m);
const posterOptions = (details.posters ?? []).slice(0, 12);
const idLine = Object.entries(ids).filter(([k]) => k !== 'wikipedia').map(([k, v]) => `${SITE_LABELS[k.replace(/_tv|_movie|_rg|_work|_album/, '')] ?? k} ${v}`).join(' · ');
const theposterdb = `https://theposterdb.com/search?term=${encodeURIComponent(m.title)}`;
const identityLine =
  m.identity === 'pinned' ? `Pinned${m.wikidataId ? ` to Wikidata ${m.wikidataId}` : ''}${idLine ? ` · ${idLine}` : ''}.`
  : m.identity === 'check' ? 'The lookup was not sure which of these it is.'
  : m.identity === 'not_found' ? 'The lookup found nothing for this title.'
  : m.identity === 'none' ? 'Marked as having no public match.'
  : 'Not looked up yet.';
---

<Base title={`Update ${m.title}`}>
  <h1>Update <a href={`/media/${m.id}`} style="color: #1B1B1B">{m.title}</a></h1>
  {error && <p class="quiet" style="margin: 8px 0 0; font-size: 15px">{error}</p>}

  <form method="POST" action={actions.updateMedia} class="update">
    <input type="hidden" name="mediaId" value={m.id} />

    <section>
      <h2>Identity</h2>
      <p class="quiet" style="margin: 0 0 8px; font-size: 15px">{identityLine} {m.wikidataId && <a href={`https://www.wikidata.org/wiki/${m.wikidataId}`}>Open</a>}</p>
      <div class="choices">
        <label class="ck"><input type="radio" name="identity" value="keep" checked /><span>{m.identity === 'pinned' ? 'Keep this match' : 'Leave as is'}</span></label>
        {candidates.map((c, i) => (
          <label class="ck"><input type="radio" name="identity" value={String(i)} /><span><span style="font-weight: 600">{c.label}</span> <span class="quiet">{candidateLine(c)}</span>{c.qid && <span class="quiet"> · {c.qid}</span>}</span></label>
        ))}
        <label class="ck"><input type="radio" name="identity" value="none" /><span>No public match</span></label>
        <label class="ck" style="flex-wrap: wrap"><input type="radio" name="identity" value="link" /><span>Use a link</span><input name="seedUrl" type="url" class="line" placeholder="https://www.imdb.com/title/…" style="width: 320px; margin-left: 8px" /></label>
      </div>
      <p class="quiet" style="margin: 6px 0 0; font-size: 14px">A new match is pinned at once; its details, links and poster follow from a refresh.</p>
    </section>

    <section>
      <h2>Description</h2>
      <label for="desc" class="visually-hidden">Description</label>
      <textarea id="desc" name="description" class="fld" rows="4">{m.description}</textarea>
      <p class="quiet" style="margin: 4px 0 0; font-size: 15px">{m.descriptionOrigin === 'model' ? 'A model draft; saving it as is makes it yours. ' : ''}[[Trope name]] links to a trope.</p>
      <label for="aliases" style="display: block; margin-top: 14px; font-weight: 600">Also known as</label>
      <input id="aliases" name="aliases" class="fld" value={m.aliases} placeholder="DGHDA, Dirk Gently" />
      <p class="quiet" style="margin: 4px 0 0; font-size: 15px">Comma-separated. The Tumblr search for your posts tries these as well as the title, its initialism and the part after a colon.</p>
      <label class="ck" style="margin-top: 14px"><input type="checkbox" name="knowledgeOnly" checked={m.knowledgeOnly} /><span>Knowledge only: never read this work's text <span class="quiet">(dossier and scans go on what the model knows; saves the model time a long show would cost)</span></span></label>
      {m.wikiExtract && <p class="quiet" style="margin: 10px 0 0; font-size: 15px"><span style="font-style: italic">Wikipedia:</span> {m.wikiExtract}</p>}
    </section>

    <section>
      <h2>Poster</h2>
      {m.notionImageUrl ? (
        <div style="display: flex; gap: 16px; align-items: flex-start">
          {m.posterPath && <img src={`/posters/${m.id}-300.webp`} alt="" style="width: 90px; height: auto" />}
          <p class="quiet" style="margin: 0; font-size: 15px">From your Notion Image Link; change it there and the next sync fetches it again.</p>
        </div>
      ) : (
        <>
          <div class="posters">
            {m.posterPath && m.posterSource && (
              <label class="pick"><input type="radio" name="poster" value={m.posterSource} checked /><img src={`/posters/${m.id}-300.webp`} alt="" /><span class="quiet">current</span></label>
            )}
            {posterOptions.filter((u) => u !== m.posterSource).map((u) => (
              <label class="pick"><input type="radio" name="poster" value={u} /><img src={u} alt="" loading="lazy" referrerpolicy="no-referrer" /><span class="quiet">{new URL(u).hostname.replace(/^www\./, '').split('.').slice(-2, -1)[0]}</span></label>
            ))}
          </div>
          <label class="ck" style="flex-wrap: wrap; margin-top: 8px"><input type="radio" name="poster" value="url" /><span>Paste an image URL</span><input name="posterUrl" type="url" class="line" placeholder="https://theposterdb.com/api/assets/…" style="width: 320px; margin-left: 8px" /></label>
          <p class="quiet" style="margin: 6px 0 0; font-size: 14px"><a href={theposterdb} target="_blank" rel="noopener">Find on theposterdb</a> and paste the asset link. Setting an Image Link in Notion overrides all of this.</p>
        </>
      )}
    </section>

    <div class="commit"><button type="submit" class="go">Save</button><a href={`/media/${m.id}`} style="font-size: 16px">Cancel</a></div>
  </form>

  <section style="margin-top: 48px">
    <h2>Files on the disk</h2>
    <p class="quiet" style="margin: 0 0 12px; font-size: 15px">{fileLine || 'Nothing matched on the media disk.'}</p>
    {refresh && <p class="quiet" style="margin: 0 0 12px; font-size: 15px">Refresh started {fmtWhen(refresh.startedAt)}: {refresh.live ? `${refresh.stage} (${refresh.status})` : refresh.status === 'done' ? `finished after ${refresh.stage}` : `${refresh.stage} ${refresh.status}`}.</p>}
    <form method="POST" action={actions.refreshLocal} style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap">
      <input type="hidden" name="mediaId" value={m.id} />
      <button type="submit" class="t" style="padding: 8px 0">Refresh from the disk</button>
      <span class="quiet" style="font-size: 15px">Finds new files (a new season), extracts their text and pictures, rebuilds the dossier if anything changed, then rechecks the tropes.</span>
    </form>
  </section>

  <section style="margin-top: 48px">
    <h2>Tropes</h2>
    {!job && (
      <>
        {lastSummary && <p class="quiet" style="margin: 0 0 12px; font-size: 15px">Checked on {fmtDate(lastCheck!.createdAt)} against {lastSummary.checked ?? '?'} tropes: {lastSummary.matched ? `${lastSummary.matched} proposed, all decided` : 'nothing new'}.{lastSummary.hasText === false ? ' No text of the work was available.' : ''}</p>}
        <form method="POST" action={actions.startSubjectCheck} style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap">
          <input type="hidden" name="subjectKind" value="media" />
          <input type="hidden" name="subjectId" value={m.id} />
          <button type="submit" class="go">Check against {tropeCount} tropes</button>
        </form>
      </>
    )}
    {job && job.status !== 'done' && <JobStatus job={job} total={tropeCount} returnTo={`/update/media/${m.id}`} what={`Checking against ${tropeCount} tropes.`} />}
    {job && job.status === 'done' && (
      <>
        <p class="quiet" style="margin: 4px 0 0; font-size: 15px">Checked against {summary.checked ?? tropeCount} tropes. Nothing is saved until you add it. <a href={`/update/media/${m.id}?job=${job.id}&discard=1`}>Start a new check</a></p>
        {warnings.map((w) => <p class="quiet" style="margin: 6px 0 0; font-size: 15px">{w}</p>)}
        {items.length === 0 && <p style="margin: 20px 0 0">Nothing new to add.</p>}
        {Astro.url.searchParams.get('discard') === '1' && (
          <form method="POST" action={actions.discardJob} style="margin-top: 12px; display: flex; gap: 16px; align-items: baseline">
            <input type="hidden" name="jobId" value={job.id} />
            <input type="hidden" name="returnTo" value={`/update/media/${m.id}`} />
            <span>Discard this check and its proposals?</span><button type="submit" class="t danger">Discard</button>
          </form>
        )}
        <div style="margin-top: 24px; max-width: 820px">
          <ProposalList jobId={job.id} items={items} framesJob={framesJobFor(db, job)} mode="subject" render={render} returnTo={returnTo} verb="Add" cancelHref={`/media/${m.id}`}>
            <h3 slot="instances-heading" style="margin: 0 0 4px; font-size: 20px; font-weight: 700">New tropes</h3>
            <h3 slot="evidence-heading" style="margin: 0 0 4px; font-size: 20px; font-weight: 700">New evidence for existing tropes</h3>
          </ProposalList>
        </div>
      </>
    )}
  </section>
</Base>

<style>
  .update { max-width: 760px; margin-top: 8px; }
  section { margin-top: 32px; }
  h2 { margin: 0 0 6px; font-size: 22px; font-weight: 700; }
  .choices { display: flex; flex-direction: column; font-size: 16px; }
  .choices .ck { padding: 3px 0; }
  .posters { display: flex; flex-wrap: wrap; gap: 12px; }
  .pick { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 13px; cursor: pointer; }
  .pick img { width: 90px; height: 135px; object-fit: cover; display: block; border: 2px solid transparent; }
  .pick:has(input:checked) img { border-color: #1B1B1B; }
  .pick input { position: absolute; opacity: 0; width: 0; height: 0; }
  .commit { margin-top: 28px; padding-top: 20px; border-top: 1px solid #1B1B1B; display: flex; gap: 20px; align-items: center; }
</style>
