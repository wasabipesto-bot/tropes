---
import { actions } from 'astro:actions';
import '../styles/global.css';
import Spoilers from '../components/Spoilers.astro';
import { db } from '../db';
import { absolute } from '../lib/config';
import { reviewCount } from '../lib/review';

interface Props {
  title: string;
  /** Trope, media and library pages use the 1440px frame; index and form pages use 980px. */
  wide?: boolean;
  current?: 'tropes' | 'library' | 'add-trope' | 'review' | 'jobs';
  /** For the description meta and OG tags; the site's own line when a page has nothing better. */
  description?: string;
  /** A site-relative image for og:image (a work's poster). */
  image?: string | null;
  /** Owner-only pages are not for crawlers or shares. */
  noindex?: boolean;
}

const { title, wide = false, current, description = 'A personal catalogue of tropes across the films, shows, books, games and podcasts in one media log.', image = null, noindex = false } = Astro.props;
const fullTitle = title === 'Trope Log' ? title : `${title} · Trope Log`;
const canonical = absolute(Astro.url.pathname, Astro.url.origin);
const owner = Astro.locals.owner;
const at = (page: Props['current']) => (current === page ? 'page' : undefined);
const waiting = owner ? reviewCount(db) : 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Trope Log" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={absolute(image, Astro.url.origin)} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class:list={['page', { wide }]}>
      <header class="site-header">
        <div class="frame">
          <a href="/tropes" class="brand">Trope Log</a>
          <nav aria-label="Main">
            <a href="/tropes" aria-current={at('tropes')}>Tropes</a>
            <a href="/library" aria-current={at('library')}>Library</a>
            {owner && <a href="/add/trope" aria-current={at('add-trope')}>Add trope</a>}
            {owner && <a href="/review" aria-current={at('review')}>Review{waiting > 0 && <span class="quiet"> {waiting}</span>}</a>}
            {owner && <a href="/jobs" aria-current={at('jobs')}>Jobs</a>}
          </nav>
          <form class="search" action="/search" method="get" role="search">
            <label for="q" class="visually-hidden">Search</label>
            <input id="q" name="q" type="search" placeholder="Search" class="line" />
          </form>
        </div>
      </header>
      <main class="frame">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="frame">
          <span>Trope Log</span>
          <a href="/tropes">Tropes</a>
          <a href="/library">Library</a>
          {owner ? (
            <a href="/account">Account</a>
            <form method="POST" action={actions.logout} style="display: inline">
              <input type="hidden" name="returnTo" value={Astro.url.pathname} />
              <button type="submit" class="t" style="color: inherit">Log out</button>
            </form>
          ) : (
            <a href="/login">Log in</a>
          )}
          <a href="https://wasabipesto.com" class="home">wasabipesto.com</a>
        </div>
      </footer>
    </div>
    <Spoilers />
  </body>
</html>
