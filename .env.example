# Site
DATABASE_PATH=./data/tropes.db
# Public origin: absolute OG and canonical links, the passkey rpID (Phase 6)
SITE_ORIGIN=https://tropes.wasabipesto.com
# Behind Cloudflare or a reverse proxy, count visitors by the forwarded address
TROPES_TRUSTED_PROXY=0
# Fair-use caps for anonymous visitors; over-cap evidence stays owner-only
TROPES_QUOTE_WORDS=100
TROPES_FRAMES_PER_WORK_TROPE=10
TROPES_CLIP_SECONDS=30
# Per-address rate limits a minute: searches, anonymous page views, the read API
TROPES_LIMIT_SEARCH=30
TROPES_LIMIT_PAGES=120
TROPES_LIMIT_API=60
# Backups (ops/backup.sh): rsync target; empty skips the copy
TROPES_BACKUP_REMOTE=braize:tropes
# Proposals scoring at least this are committed without review on the automatic path for Notion-synced entries (0.5 is the review cut).
TROPES_AUTO_COMMIT_MIN=0.7

# Worker
TROPES_SITE_URL=http://127.0.0.1:4321
TROPES_API_TOKEN=
OPENROUTER_API_KEY=
TROPES_MIDDEN_KEY=

# Phase 4: external metadata (each is optional; a missing key skips that source with a warning)
TROPES_TMDB_TOKEN=
TROPES_MAL_CLIENT_ID=
# Read-only Notion integration shared with the Media Log; the worker syncs it every TROPES_NOTION_SYNC_MINUTES (default 15, 0 disables).
NOTION_API_KEY=

# Phase 5: the media worker (set only on the machine with the files; it then takes the file jobs and no model jobs)
TROPES_MEDIA_ROOT=
# The media worker re-indexes the disk every this many hours (0 disables); set TROPES_AUTO_DOSSIER=1 to let that
# index go on to rebuild the dossiers whose text changed and recheck their tropes (spends model money)
TROPES_INDEX_HOURS=168
TROPES_AUTO_DOSSIER=0
# Whisper fallback on the media worker (uv sync --extra whisper); the systemd unit caps the CPU
TROPES_WHISPER_MODEL=medium.en
TROPES_WHISPER_THREADS=8
# OpenSubtitles account login raises the daily quota from 5 to 20
TROPES_OPENSUBTITLES_USER=
TROPES_OPENSUBTITLES_PASSWORD=
# Texts over this many tokens are read in season blocks (plan D7); on the model worker
TROPES_TEXT_CAP_TOKENS=600000
